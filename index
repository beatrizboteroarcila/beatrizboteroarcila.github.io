<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beatriz Botero Arcila — Assistant Professor of Law, Sciences Po Paris</title>
    <meta name="description" content="Beatriz Botero Arcila is an Assistant Professor of Law at Sciences Po and a Faculty Associate at Harvard's Berkman Klein Center. Her work is on AI liability, data governance, and digital regulation.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        /* ========== Artsy white — editorial studio variant ========== */
        :root {
            --paper: #FFFFFF;
            --ink: #17140F;
            --muted: #6A645C;
            --faint: #A49E95;
            --line: #E9E6DF;
            --accent: #9C1B31;
            --serif: 'Playfair Display', Georgia, serif;
            --sans: 'Inter', system-ui, sans-serif;
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
        body {
            font-family: var(--sans); color: var(--ink); background: var(--paper);
            font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased;
            font-feature-settings: "liga" 1, "calt" 1;
        }
        ::selection { background: var(--ink); color: var(--paper); }
        a { color: inherit; text-decoration: none; }
        img { max-width: 100%; display: block; }
        :focus-visible { outline: 1.5px solid var(--accent); outline-offset: 3px; }

        .wrap { max-width: 1120px; margin: 0 auto; padding: 0 2.5rem; }

        /* ---------- Top bar ---------- */
        .top {
            position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,0.86);
            backdrop-filter: blur(8px); border-bottom: 1px solid var(--line);
        }
        .top .wrap { display: flex; align-items: center; justify-content: space-between; height: 56px; }
        .top .sig { font-family: var(--serif); font-size: 1.15rem; letter-spacing: 0.01em; }
        .top nav { display: flex; gap: 1.6rem; }
        .top nav a {
            font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em;
            color: var(--muted); transition: color 0.2s;
        }
        .top nav a:hover { color: var(--ink); }
        @media (max-width: 720px) { .top nav { display: none; } }

        /* ---------- Hero ---------- */
        .hero { padding: 7rem 0 5.5rem; }
        .eyebrow {
            font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.18em;
            color: var(--muted); margin-bottom: 1.6rem;
        }
        .hero h1 {
            font-family: var(--serif); font-weight: 500;
            font-size: clamp(3.2rem, 9vw, 6.4rem); line-height: 0.98; letter-spacing: -0.015em;
        }
        .hero .statement {
            font-family: var(--serif); font-style: italic;
            font-size: clamp(1.35rem, 3.2vw, 2.1rem); line-height: 1.3; color: var(--muted);
            margin-top: 1.6rem; max-width: 24ch;
        }
        .hero .links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2.5rem; }
        .hero .links a {
            font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
            color: var(--muted); padding-bottom: 3px; border-bottom: 1px solid var(--line);
            transition: color 0.2s, border-color 0.2s;
        }
        .hero .links a:hover { color: var(--ink); border-color: var(--ink); }

        /* ---------- Section shell ---------- */
        .sec { border-top: 1px solid var(--line); padding: 3.6rem 0; }
        .sec-grid { display: grid; grid-template-columns: 190px 1fr; gap: 3rem; }
        .sec-label {
            font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted);
            display: flex; gap: 0.7rem; align-items: baseline; height: fit-content;
        }
        .sec-label .n { font-family: var(--serif); font-size: 1.1rem; color: var(--accent); letter-spacing: 0; }
        .sec-body { min-width: 0; }

        /* ---------- About ---------- */
        .about {
            font-family: var(--serif); font-weight: 500; font-size: clamp(1.5rem, 2.6vw, 1.95rem);
            line-height: 1.35; color: var(--ink);
        }
        .about .hl { color: var(--accent); }
        .about p + p { margin-top: 1.1rem; }
        .fields { margin-top: 2rem; font-size: 0.9rem; color: var(--muted); line-height: 1.9; }
        .fields b { color: var(--ink); font-weight: 500; }

        /* ---------- Editorial lists ---------- */
        .item { padding: 1.5rem 0; border-top: 1px solid var(--line); }
        .item:first-child { border-top: none; padding-top: 0; }
        .kicker {
            font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.13em; color: var(--muted);
        }
        .kicker.flag { color: var(--accent); }
